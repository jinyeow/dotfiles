{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/inject-handoff.ps1",
            "shell": "bash"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/skills/project-brain/scripts/session-start.ps1",
            "shell": "bash"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/warn-reasoning-extraction.ps1",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/no-claude-session-trailer.sh",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/block-destructive-vcs.ps1",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/block-pwsh-in-bash.ps1",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/warn-legacy-files.ps1",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/warn-reasoning-extraction.ps1",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/lint-powershell.ps1",
            "shell": "bash",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File ~/.claude/warn-hardcoded-secrets.ps1",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"[console]::beep(); [console]::Write([char]7)\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"[console]::beep()\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "project-artifact@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "hookify@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "concise",
  "effortLevel": "medium",
  "advisorModel": "opus",
  "teammateMode": "in-process",
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "defaultShell": "powershell",
  "preferredNotifChannel": "terminal_bell",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "disableWorkflows": true,
  "disableAiConnectors": true
}

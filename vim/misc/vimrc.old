" ========================================================================
" => AUTOCMD {{{
" ========================================================================
augroup vimrc
  autocmd!
  " Reload vimrc when edited
  autocmd BufWritePost ~/.vimrc
        \ so % | if has('gui_running') | so % | endif

  " Change working directory to current file's directory
  " autocmd BufEnter * lcd %:p:h

  autocmd BufRead,BufNewFile *.h,*.c set filetype=c.doxygen
  autocmd BufRead,BufNewFile *.h,*.c command! A call s:a()

  " Save on losing focus i.e. tabbing away from vim
  autocmd FocusLost * :wa

  " Run Neomake on the current file on every write
  autocmd! BufWritePost * Neomake

  " If you prefer the Omni-Completion tip window to close when a selection is
  " made, these lines close it on movement in insert mode or when leaving
  " insert mode
  autocmd CursorMovedI * if pumvisible() == 0|pclose|endif
  autocmd InsertLeave * if pumvisible() == 0|pclose|endif

  autocmd BufNewFile,BufReadPost *.md set filetype=markdown

  autocmd BufNewFile,BufRead *.rb,*.rbw,*.gemspec setlocal filetype=ruby
  autocmd FileType ruby set tabstop=2|set shiftwidth=2|set expandtab

  autocmd FileType asm,s,S setlocal syntax=avr.vim
  autocmd BufRead,BufNewFile *.asm,*.s,*.S set syntax=avr.vim

  " Unset paste on InsertLeave
  autocmd InsertLeave * silent! set nopaste

  " Mark filetype on BufLeave. Makes it easy to go back to latest buffer of
  " [filetype].
  " NOTE: maybe change mC to *.c filetypes and mJ to *.java filetypes ??
  autocmd BufLeave *.css,*.less,*scss normal! mC
  autocmd BufLeave *.html             normal! mH
  autocmd BufLeave *.js               normal! mJ
  autocmd BufLeave *.c,*.cpp          normal! mC
  autocmd BufLeave *.h                normal! mH
  autocmd BufLeave *.java             normal! mJ
  autocmd BufLeave *.py               normal! mP
  autocmd BufLeave *.rb               normal! mR
  autocmd BufLeave *.ex,*.exs         normal! mE
  autocmd BufLeave *.go               normal! mG
  autocmd BufLeave *.md               normal! mM
  autocmd BufLeave vimrc,*.vim        normal! mV

  autocmd FileType css setlocal omnifunc=csscomplete#CompleteCSS
  autocmd FileType html,markdown setlocal omnifunc=htmlcomplete#CompleteTags
  autocmd FileType javascript setlocal omnifunc=javascriptcomplete#CompleteJS
  autocmd FileType xml setlocal omnifunc=xmlcomplete#CompleteTags
augroup END

" }}}
" ========================================================================
" => BASIC SETTINGS {{{
" ========================================================================

filetype plugin indent on " load filetype-specific indent files
syntax enable " enable syntax processing

scriptencoding utf-8 " allows for arrows to display in NERDTree
set encoding=utf-8
set fileencoding=utf-8

" Search recursively into subdirectories
set path+=**

" This snippet tells Vim to look for tags files in the directory of the current
" file and in the current directory and up and up until /
set tags=./tags,tags;$HOME

" => Spaces & Tabs
set tabstop=2 " numberof visual spaces per TAB
set softtabstop=2 " number of spaces in tab when editing
set expandtab " tabs are spaces
set shiftwidth=2 " indenting a line with >> or << will indent or un-indent by 2
set smarttab " indent to correct location with tab
set autoindent
set copyindent

" if filetype is c, python, assembly, java, go set tab to 4 spaces instead of 2
if has("autocmd")
  autocmd FileType python,c,h,asm,java,go setlocal tabstop=4
  autocmd FileType python,c,h,asm,java,go setlocal shiftwidth=4
  autocmd FileType python,c,h,asm,java,go setlocal softtabstop=4
  autocmd FileType python,c,h,asm,java,go setlocal nowrap
endif

" => matchit.vim
" enable matchit plugin which ships with vim and greatly enhances '%'
" '%' key now matches (), {}, [], def end, etc.
runtime macros/matchit.vim

set number " show line numbers
set numberwidth=3
set relativenumber " show relative line numbers
set ruler

set showcmd " show command in bottom bar
set showmode

set cursorline " highlight current line

set wildmenu " visual autocomplete for command menu
set wildmode=full

set lazyredraw
set showmatch
set laststatus=2
set modeline " always show file name

set textwidth=110 " any line will only be maximum 110 characters long
set colorcolumn=80 " column 80 is a different color
set backspace=indent,eol,start " makes backspace behave normally

set history=10000
set undolevels=10000 " more undos
set undofile
set undodir=~/dotfiles/vimundo/

set hidden " hides buffers; allows changing buffers without saving it first

set complete=.,b,u,w,i,]
set completeopt=menu,preview
" set complete=.,b,u,]
" set completeopt-=preview

set list listchars=tab:▸\ ,eol:¬,trail:·
set splitbelow splitright " Open new split panes to right and bottom
" set virtualedit=onemore " allow for cursor beyond last character
set virtualedit=all
set autoread " Set to auto read when file is changed from the outside
set scrolloff=5
set visualbell

" Lower the delay of escaping out of other modes
set timeout timeoutlen=1000 ttimeoutlen=1

" when reading files try unix line endings then dos, also use unix for new buffers
set fileformats=unix,dos
set fileformat=unix " set unix line endings
set exrc
set secure

" Set clipboard to use system clipboard
set clipboard^=unnamed,unnamedplus

set shell=/bin/zsh

set noswapfile
set nobackup
set nowb

set incsearch " search as characters are entered
set hlsearch " highlight matches
set ignorecase " ignore case when searching
set smartcase " ...unless there's a capital letter in the query

set nojoinspaces
set diffopt=filler,vertical

set grepformat=%f:%l:%c:%m,%f:%l:%m
set nrformats=hex

" NOTE: I am trying the following options out.
set breakindent " wrapped lines are visually idented
set linebreak

" Set netrw config
let g:netrw_liststyle = 3 " tree style listing
let g:netrw_winsize   = 20 " when :Vexplore limit window size for aesthetics

set mouse=""

" }}}
" ========================================================================
" => FOLDING {{{
" ========================================================================
set foldenable " enable folding
set foldlevelstart=10 " open most folds by default
set foldnestmax=10 " 10 nested fold max
set modelines=1
set foldmethod=marker

" }}}
" ========================================================================
" => COLOR CHANGES/SCHEMES & FONT {{{
" ========================================================================
set t_co=256

let hour = strftime("%H")
if 7 <= hour && hour < 18 " i.e. daytime
  set background=light
else
  set background=dark
endif

" Set colorscheme depending on $TERM (i.e. termite, urxvt, or tmux)
if $TERM == 'xterm-termite' || $TERM == 'screen'
  if (has("termguicolors"))
    set termguicolors " doesn't work with urxvt, or tmux
  endif
  color NeoSolarized " other good colors: gruvbox, hybrid_material, OceanicNext
else " basically just for urxvt
  color base16-oceanicnext " other colors: PaperColor(L)

  " To output all highlight groups use Ex-Mode command ':so $VIMRUNTIME/syntax/hitest.vim'
  hi LineNr                    ctermfg=green     ctermbg=black
  hi SignColumn                ctermbg=black     ctermbg=black
  hi GitGutterAdd              ctermfg=green     ctermbg=black
  hi GitGutterChange           ctermfg=yellow    ctermbg=black
  hi GitGutterDelete           ctermfg=red       ctermbg=black
  hi GitGutterChangeDelete     ctermfg=blue      ctermbg=black
  hi Pmenu                                       ctermbg=238
  hi ColorColumn                                 ctermbg=238
  hi CursorLine                                  ctermbg=238
  hi Folded                                      ctermbg=black
  hi VertSplit                 ctermfg=white     ctermbg=238
  hi WildMenu                  ctermfg=black     ctermbg=white
  hi Visual                                      ctermbg=238
  hi Todo                      ctermfg=yellow    ctermbg=238
  " hi SyntasticStyleWarningSign ctermfg=yellow    ctermbg=black
  " hi SyntasticStyleErrorSign   ctermfg=red       ctermbg=black
  " hi SyntasticWarningSign      ctermfg=yellow    ctermbg=black
  " hi SyntasticErrorSign        ctermfg=red       ctermbg=black
  hi StatusLine                ctermfg=white     ctermbg=black
  hi clear SignColumn
endif

" }}}
" ========================================================================
" => MAPPINGS {{{
" ========================================================================
" move vertically by visual line
nnoremap j gj
nnoremap k gk

" move to begging/end of line
map 0 ^

" unmap arrow keys
nnoremap <up> <nop>
nnoremap <down> <nop>
nnoremap <left> <nop>
nnoremap <right> <nop>

" Buffer navigation
noremap <leader>p :bp<CR>
noremap <leader>n :bn<CR>
nnoremap <S-right> <ESC>:bn<RETURN>
nnoremap <S-left> <ESC>:bp<RETURN>

" Close buffer
noremap <leader>d :bd<CR>

" Retain visual selection after indenting
vnoremap < <gv
vnoremap > >gv
vnoremap <S-Tab> <gv
vnoremap <Tab> >gv

" Make Y behave like other capitals
nnoremap Y y$

" turn off search highlight
nnoremap <silent>  <space> :nohlsearch<CR>

" changes the default Vim regexes to sane/regular regex. or something.
nnoremap / /\v
vnoremap / /\v
nnoremap ? ?\v
vnoremap ? ?\v
nnoremap :s/ :s/\v

set gdefault " defaults substitutions globally on lines

" center screen when scrolling search results
nnoremap n nzz
nnoremap N Nzz

" Have the help split vertically instead of the default horizontally.
" cnoremap help vert help
cabbrev h vert h

nnoremap <Leader>ws :call DeleteTrailingWS()<CR>:w<CR>

" NOTE: - the following don't work in vim because it's captured by the terminal
" for `stty start` signal. <c-q> is the opposite of <c-s> (<c-s> stops
" terminal output scrolling
" inoremap <C-Q> <esc>:q<cr>
" nnoremap <C-Q> :q<cr>
" vnoremap <C-Q> <esc>

" Readline-style key bindings in command-line (excerpt from rsi.vim)
cnoremap        <C-A> <Home>
cnoremap        <C-E> <End>
cnoremap        <C-B> <Left>
cnoremap <expr> <C-D> getcmdpos()>strlen(getcmdline())?"\<Lt>C-D>":"\<Lt>Del>"
cnoremap <expr> <C-F> getcmdpos()>strlen(getcmdline())?&cedit:"\<Lt>Right>"
cnoremap        <M-b> <S-Left>
cnoremap        <M-f> <S-Right>
silent! exe "set <S-Left>=\<Esc>b"
silent! exe "set <S-Right>=\<Esc>f"

" #!! | Shebang
inoreabbrev <expr> #!! "#!/usr/bin/env" . (empty(&filetype) ? '' : ' '.&filetype)

" :Chomp
command! Chomp silent! normal! :%s/\s\+$//<cr>

" Easy pane resizing
nnoremap <Left> <C-w><
nnoremap <Down> <C-w>-
nnoremap <Up> <C-w>+
nnoremap <Right> <C-w>>

" }}}
" ========================================================================
" => COMMANDS {{{
" ========================================================================
" :Chomp trailing whitespace
command! Chomp silent! normal! :%s/\s\+$//<CR>

" Split XML/HTML from a single-line to multi-line
" command! HTMLSplit normal! cit<CR><C-r>"<CR><ESC>
" command! HTMLSplit normal! :s;>\s*<;>\r<;g<CR>='[

" :SwapLine [line] will swap the current line with the given line number.
" NOTE: :SwapLine will overwrite the line below if given a count that is the
" same as the line number of the current line.
command! -count SwapLine silent! normal! msyy<count>ggPjdd`sVpms

" :SwapRel{Next,Prev} will swap lines relative to the current line
command! -count SwapRelNext silent! normal! msyy<count>jPjdd`sVpms
command! -count SwapRelPrev silent! normal! msyy<count>kpkdd`sVpms

" :Swap{Next,Prev}. Swaps the current line with the next/previous line
command! SwapNext silent! normal! :SwapRelNext 1<CR>
command! SwapPrev silent! normal! :SwapRelPrev 1<CR>

" }}}
" ========================================================================
" => PLUGINS CONFIG {{{
" ========================================================================

" ========================================================================
" => VIM-PLUG
" ========================================================================
let g:plug_threads = 80

" ========================================================================
" => ACK/AG
" ========================================================================
if executable('ag')
  let &grepprg = 'ag --nogroup --nocolor --column'
  let g:ag_working_path_mode="r"
else
  let &grepprg = 'grep -rn $* *'
endif
command! -nargs=1 -bar Grep execute 'silent! grep! <q-args>' | redraw! | copen

" ========================================================================
" => VIM-AIRLINE
" ========================================================================
" NOTE: using vim-airline-themes plugin.
" AirlineTheme should default to colorscheme; i.e. solarized
" let g:airline_theme                                  = 'b16'
let g:airline_detect_modified                        = 1
let g:airline_detect_paste                           = 1
let g:airline_inactive_collapse                      = 1
let g:airline_powerline_fonts                        = 1

let g:airline#extensions#branch#enabled              = 1
let g:airline#extensions#branch#displayed_head_limit = 10

" disable so that tmuxline doesn't get overwritten when airline theme changes
let g:airline#extensions#tmuxline#enabled            = 0

let g:airline#extensions#ctrlp#show_adjacent_modes   = 1
let g:airline#extensions#tagbar#enabled              = 1
let g:airline#extensions#obsession#enabled           = 1
" let g:airline#extensions#eclim#enabled               = 0

" Tabline - the bar at the top
let g:airline#extensions#tabline#enabled           = 1
let g:airline#extensions#tabline#show_buffers      = 1
let g:airline#extensions#tabline#tabs_min_count    = 2
let g:airline#extensions#tabline#buffer_min_count  = 2
let g:airline#extensions#tabline#show_close_button = 0

let g:airline_left_sep       = ''
let g:airline_left_alt_sep   = '|'
let g:airline_right_sep      = ''
let g:airline_right_alt_sep  = '|'

if !exists('g:airline_symbols')
  let g:airline_symbols = {}
endif

let g:airline_symbols.linenr    = ''
let g:airline_symbols.maxlinenr = ''

" ========================================================================
" => ALCHEMIST.VIM
" ========================================================================
" let g:alchemist_tag_disable = 1
let g:alchemist#elixir_erlang_src = "/usr/local/share/src"

" ========================================================================
" => C-SUPPORT
" ========================================================================
let g:C_Ctrl_j   = 'off'

" ========================================================================
" => CTRLP
" ========================================================================
let g:ctrlp_map = '<C-p>'
let g:ctrlp_cmd = 'CtrlP'
nnoremap <Leader>bu :CtrlPBuffer<CR>

let g:ctrlp_extensions = ['funky', 'menu', 'changes', 'mixed', 'dir']

" The Silver Searcher
if executable('ag')
  " Use ag over grep
  set grepprg=ag\ --nogroup\ --nocolor

  " Use ag in CtrlP for listing files. Lightning fast and respects .gitignore
  let g:ctrlp_user_command = 'ag %s -l --nocolor --nogroup --hidden
      \ --ignore .git
      \ --ignore .svn
      \ --ignore .hg
      \ --ignore .DS_Store
      \ --ignore "**/*.pyc"
      \ -g ""'

  " Ag is fast enough that ctrlp does not need to cache
  let g:ctrlp_use_caching = 0
endif

" Ignore some folders and files for CtrlP indexing
let g:ctrlp_custom_ignore = {
  \ 'dir': '\.git$\|\.yardoc\|public$|log\|tmp$',
  \ 'file': '\.so$\|\.dat$|\.DS_Store$'
  \ }

let g:ctrlp_working_path_mode   = 'ra'
let g:ctrlp_show_hidden         = 1
let g:ctrlp_clear_cache_on_exit = 0
let g:ctrlp_tilde_homedir       = 1

if has('win32')
  set wildignore+=*\\.git\\*,*\\.hg\\*,*\\.svn\\*
  let g:ctrlp_user_command = 'dir %s /-n /b /s /a-d'
else
  set wildignore+=*/.git/*,*/.hg/*,*/.svn/*
endif

let g:ctrlp_match_func = { 'match': 'pymatcher#PyMatch' }

" ========================================================================
" => CTRLP-FUNKY
" ========================================================================
nnoremap <Leader>fu :CtrlPFunky<Cr>
" narrow the list down with a word under cursor
nnoremap <Leader>fU :execute 'CtrlPFunky ' . expand('<cword>')<Cr>

let g:ctrlp_funky_syntax_highlight = 1
let g:ctrlp_funky_multi_buffers    = 1

" ========================================================================
" => CTRLP_BDELETE
" ========================================================================
call ctrlp_bdelete#init()

" ========================================================================
" => CTRLP-RAILS
" ========================================================================
nnoremap <Leader>rm :CtrlPModels<Cr>
nnoremap <Leader>rc :CtrlPControllers<Cr>
nnoremap <Leader>rv :CtrlPViews<Cr>

" ========================================================================
" => CTRLP-TJUMP
" ========================================================================
nnoremap <Leader>tj :CtrlPtjump<cr>
vnoremap <Leader>tj :CtrlPtjumpVisual<cr>
nnoremap <Leader><c-]> :CtrlPtjump<cr>
vnoremap <Leader><c-]> :CtrlPtjumpVisual<cr>
let g:ctrlp_tjump_only_silent = 1
" let g:ctrlp_tjump_skip_tag_name = 1

" ========================================================================

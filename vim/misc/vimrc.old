" ========================================================================
" => FZF.VIM
" ========================================================================
" function! s:find_root()
"   for vcs in ['.git', '.svn', '.hg']
"     let dir = finddir(vcs.'/..', ';')
"     if !empty(dir)
"       execute 'Files' dir
"       return
"     endif
"   endfor
"   Files
" endfunction
" command! FZFR call s:find_root()

" function! s:find_git_root()
"   return system('git rev-parse --show-toplevel 2> /dev/null')[:-2]
" endfunction
" command! ProjectFiles execute 'Files' s:find_git_root()

let $FZF_DEFAULT_OPTS .= ' --inline-info'
let g:fzf_command_prefix = 'Fzf'

" Rails Models/Views/Controllers
command! FzfModels execute 'Files app/models/'
command! FzfViews execute 'Files app/views'
command! FzfControllers execute 'Files app/controllers'

nnoremap <Leader>fa :FzfAg<CR>

nnoremap <Leader>ff :FzfFiles<CR>
nnoremap <Leader>fF :FzfFiles ~<CR>

nnoremap <Leader>fb :FzfBuffers<CR>
nnoremap <Leader>fw :FzfWindows<CR>

nnoremap <Leader>fg :FzfGitFiles<CR>

nnoremap <Leader>ft :FzfTags<CR>
nnoremap <Leader>fT :FzfBTags<CR>

nnoremap <Leader>fl :FzfLines<CR>
nnoremap <Leader>fL :FzfBLines<CR>

nnoremap <Leader>fM :FzfMarks<CR>

let g:fzf_layout = { 'down': '~25%' }

" let g:fzf_action = {
"   \ 'ctrl-t': 'tab split',
"   \ 'ctrl-x': 'split',
"   \ 'ctrl-v': 'vsplit' }

" [Files] Extra options for fzf
"   e.g. File preview using Highlight
"        (http://www.andre-simon.de/doku/highlight/en/highlight.html)
let g:fzf_files_options =
  \ '--preview "(highlight -O ansi {} || cat {}) 2> /dev/null | head -'.&lines.'"'

" [Buffers] Jump to the existing window if possible
let g:fzf_buffers_jump = 1

" [[B]Commits] Customize the options used by 'git log':
let g:fzf_commits_log_options = '--graph --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr"'

" [Tags] Command to generate tags file
let g:fzf_tags_command = 'ctags -R'

" [Commands] --expect expression for directly executing the command
let g:fzf_commands_expect = 'alt-enter,ctrl-x'


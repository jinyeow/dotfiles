// Zellij config — %APPDATA%\Zellij\config\config.kdl  (Windows)
//                  ~/.config/zellij/config.kdl          (Linux)
//
// Design: "locked-first" — all key input passes through to the pane by default
// (no accidental zellij commands while typing in nvim etc.).
// Press Ctrl+g to enter command mode; most actions return to locked when done.
// In scroll/resize/move modes, press Ctrl+g or Esc to return to locked.

// --- Startup ----------------------------------------------------------------
default_mode "locked"
default_shell "pwsh"
show_startup_tips false
show_release_notes false

// --- UI ---------------------------------------------------------------------
pane_frames true
rounded_corners true
simplified_ui false          // keep arrow-font decorations in tab/status bars

// --- Behaviour --------------------------------------------------------------
mouse_mode true
copy_on_select false         // don't auto-copy text on mouse-release
copy_clipboard "system"
scroll_buffer_size 10000
scrollback_editor "nvim"     // open scrollback in nvim (scroll mode → e)
session_serialization true   // resume sessions after detach / reboot
pane_viewport_serialization true
osc8_hyperlinks true         // clickable file:// and https:// links

// --- Theme ------------------------------------------------------------------
// Theme files live in themes/ alongside this file (pulled in via the junction).
// The new semantic format (text_unselected / ribbon_selected / etc.) is
// required for Zellij 0.40+; old fg/bg palette blocks render incorrectly.
// theme_dark/theme_light auto-switch on CSI 2031 signal from the terminal.
// Windows Terminal does not emit CSI 2031 — use: zellij action toggle-theme
theme_dark  "catppuccin-mocha"
theme_light "catppuccin-latte"

// --- Keybindings ------------------------------------------------------------
// clear-defaults=true gives a clean slate — only these bindings are active.
keybinds clear-defaults=true {

    // ── Locked (pass-through) ────────────────────────────────────────────────
    // Every key goes to the pane. Only Ctrl+g escapes to command mode.
    // Alt+[/] cycle pane layouts without needing to enter command mode.
    //
    // Ctrl+hjkl: vim-zellij-navigator detects whether the focused pane is
    // running nvim. If yes, it forwards the key to nvim so zellij-nav.nvim
    // can move between nvim windows first; at the window edge zellij-nav.nvim
    // calls "zellij action move-focus" to cross into the adjacent pane.
    // If the pane is a shell (not nvim), it moves the zellij pane directly.
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
        bind "Alt ["  { PreviousSwapLayout; }
        bind "Alt ]"  { NextSwapLayout; }
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "left";
                move_mod "ctrl";
                use_arrow_keys "false";
            };
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "down";
                move_mod "ctrl";
            };
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus";
                payload "up";
                move_mod "ctrl";
            };
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab";
                payload "right";
                move_mod "ctrl";
            };
        }
    }

    // ── Normal (command mode) ────────────────────────────────────────────────
    // Entered via Ctrl+g from locked. Esc or Ctrl+g returns to locked.
    // Most single-action binds return to locked automatically.
    normal {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Esc"    { SwitchToMode "locked"; }

        // Pane focus — wraps to the adjacent tab at left/right edges
        bind "h" { MoveFocusOrTab "left";  SwitchToMode "locked"; }
        bind "l" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "j" { MoveFocus "down";       SwitchToMode "locked"; }
        bind "k" { MoveFocus "up";         SwitchToMode "locked"; }

        // Pane splits  (- = horizontal below, \ = vertical right)
        bind "-"  { NewPane "down";  SwitchToMode "locked"; }
        bind "\\" { NewPane "right"; SwitchToMode "locked"; }

        // Pane actions
        bind "x"     { CloseFocus;              SwitchToMode "locked"; }
        bind "z"     { ToggleFocusFullscreen;   SwitchToMode "locked"; }
        bind "f"     { ToggleFloatingPanes;     SwitchToMode "locked"; }
        bind "Space" { TogglePaneEmbedOrFloating; SwitchToMode "locked"; }
        bind "p"     { TogglePanePinned;        SwitchToMode "locked"; }

        // Break pane out of current tab
        bind "b" { BreakPane;      SwitchToMode "locked"; }
        bind "[" { BreakPaneLeft;  SwitchToMode "locked"; }
        bind "]" { BreakPaneRight; SwitchToMode "locked"; }

        // Rename focused pane (clears existing name, then type new name)
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }

        // Tabs
        bind "n"         { NewTab;          SwitchToMode "locked"; }
        bind "X"         { CloseTab;        SwitchToMode "locked"; }
        bind "Tab"       { GoToNextTab;     SwitchToMode "locked"; }
        bind "Shift Tab" { GoToPreviousTab; SwitchToMode "locked"; }
        bind "H"         { MoveTab "Left";  SwitchToMode "locked"; }
        bind "L"         { MoveTab "Right"; SwitchToMode "locked"; }
        bind "R"         { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "1" { GoToTab 1; SwitchToMode "locked"; }
        bind "2" { GoToTab 2; SwitchToMode "locked"; }
        bind "3" { GoToTab 3; SwitchToMode "locked"; }
        bind "4" { GoToTab 4; SwitchToMode "locked"; }
        bind "5" { GoToTab 5; SwitchToMode "locked"; }

        // Sub-modes (stay in mode for repeated use; Ctrl+g or Esc to return)
        bind "s" { SwitchToMode "scroll"; }
        bind "r" { SwitchToMode "resize"; }
        bind "m" { SwitchToMode "move"; }

        // Session
        bind "d" { Detach; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
    }

    // ── Rename pane ──────────────────────────────────────────────────────────
    // Type the new name, then Enter to confirm or Esc to cancel.
    renamepane {
        bind "Enter"  { SwitchToMode "locked"; }
        bind "Ctrl c" { SwitchToMode "locked"; }
        bind "Esc"    { UndoRenamePane; SwitchToMode "locked"; }
    }

    // ── Rename tab ───────────────────────────────────────────────────────────
    renametab {
        bind "Enter"  { SwitchToMode "locked"; }
        bind "Ctrl c" { SwitchToMode "locked"; }
        bind "Esc"    { UndoRenameTab; SwitchToMode "locked"; }
    }

    // ── Move ─────────────────────────────────────────────────────────────────
    // Swap the focused pane's position with an adjacent pane.
    move {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Esc"    { SwitchToMode "locked"; }
        bind "h" "Left"  { MovePane "left"; }
        bind "j" "Down"  { MovePane "down"; }
        bind "k" "Up"    { MovePane "up"; }
        bind "l" "Right" { MovePane "right"; }
        bind "n"         { MovePane; }
        bind "p"         { MovePaneBackwards; }
    }

    // ── Scroll ───────────────────────────────────────────────────────────────
    scroll {
        bind "Ctrl g" { ScrollToBottom; SwitchToMode "locked"; }
        bind "Esc"    { ScrollToBottom; SwitchToMode "locked"; }
        bind "q"      { ScrollToBottom; SwitchToMode "locked"; }
        bind "j"      { ScrollDown; }
        bind "k"      { ScrollUp; }
        bind "d"      { HalfPageScrollDown; }
        bind "u"      { HalfPageScrollUp; }
        bind "Ctrl f" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "g"      { ScrollToTop; }
        bind "G"      { ScrollToBottom; SwitchToMode "locked"; }
        bind "e"      { EditScrollback; SwitchToMode "locked"; }
        bind "/"      { SwitchToMode "entersearch"; SearchInput 0; }
    }

    // ── Enter search (type your query) ───────────────────────────────────────
    entersearch {
        bind "Enter"  { SwitchToMode "search"; }
        bind "Ctrl c" { SearchInput 27; SwitchToMode "search"; }
        bind "Esc"    { SearchInput 27; SwitchToMode "scroll"; }
    }

    // ── Search (navigate results) ─────────────────────────────────────────────
    search {
        bind "Ctrl g" { ScrollToBottom; SwitchToMode "locked"; }
        bind "Esc"    { ScrollToBottom; SwitchToMode "locked"; }
        bind "q"      { ScrollToBottom; SwitchToMode "locked"; }
        bind "n"      { Search "down"; }
        bind "N"      { Search "up"; }
        bind "j"      { ScrollDown; }
        bind "k"      { ScrollUp; }
        bind "c"      { SearchToggleOption "CaseSensitivity"; }
        bind "w"      { SearchToggleOption "Wrap"; }
        bind "o"      { SearchToggleOption "WholeWord"; }
        bind "/"      { SwitchToMode "entersearch"; SearchInput 0; }
    }

    // ── Resize ───────────────────────────────────────────────────────────────
    resize {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Esc"    { SwitchToMode "locked"; }
        bind "h" { Resize "Left"; }
        bind "j" { Resize "Down"; }
        bind "k" { Resize "Up"; }
        bind "l" { Resize "Right"; }
        bind "=" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
}

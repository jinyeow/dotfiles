#compdef scrape_imgur

_scrape_imgur() {
  local -a _scrape_arguments
  _scrape_arguments=(
    "--help:Show help message"
    "--output:Specify directory to scrape to"
    "--title:Specify filename for a single image"
    "--nsfw:Use the 'nsfw' directory instead of the default 'scraped'"
    "--kpics:Use the 'kpics' directory instead of the default 'scraped'"
    "--throttle:Wait TIME seconds between downloads"
    "--sleep:Wait TIME seconds between sets of images"
    "--add-ordering:Prepend ordered number to filenames"
    "--debug:Print out image data for debugging purposes"
  )

  if (( CURRENT >= 2 )); then
    _describe -t commands "scrape_imgur" _scrape_arguments
  fi

  return 0
}

_scrape_imgur


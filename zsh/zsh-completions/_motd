#compdef motd

_motd() {
  local -a _motd_args
  _motd_args=(
    "add:Add a message of the day."
    "append:Append to the message of the day."
    "remove:Remove the message of the day."
    "print:Print the message of the day."
    "help:Print the help message."
  )

  if (( CURRENT >= 2 )); then
    _describe -t commands "motd" _motd_args
  fi

  return 0
}

_motd


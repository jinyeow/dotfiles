#compdef todo

_todo() {
  local -a _todo_args
  _todo_args=(
    "help:Print this message."
    "add:Add a todo."
    "remove:Remove a todo."
    "list:List all todos."
    "clear:Clear all todos."
    "reorder:Reorders any out of order todos."
  )

  # TODO add a case for the command "todo remove" that lists the todos that I
  # can tab through to remove one.
  if (( CURRENT >= 2 )); then
    _describe -t commands "todo" _todo_args
  fi

  return 0
}

_todo

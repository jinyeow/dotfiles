#compdef edit

_edit() {
  local -a _edit_args
  _edit_args=(
    "configs:Edit various config files."
    "projection:Edit {filetype}_projections.json files."
    "scripts:Edit various scripts."
    "stories:Edit story project."
    "zsh:Edit zsh configs, modules, and miscellaneous items."
    "list:Lists editable things."
    "help:Prints help message."
  )

  if (( CURRENT >= 2 )); then
    _describe -t commands "edit" _edit_args
  fi

  return 0
}

_edit

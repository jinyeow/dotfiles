###############################################################################
#                             ==MIX zsh completion==                          #
# * Description: Completion script for mix                                    #
#                     (http://elixir-lang.org/docs/v1.1/mix/Mix.html)         #
# * Author: Jin-Yeow Justin Puah                                              #
###############################################################################

# TODO: update this; match mix-fast zsh plugin to speed up
_mix() {
  local -a _mix_arguments
  _mix_arguments=(
    "${(@f)$(mix help | egrep "^mix " | tail -n+2 | sed 's/^mix //;s/\s\+#\s/:/')}"
    '--help:Describe available tasks'
    '--version:Prints the Elixir version information'
  )

  # TODO: Figure out difference between CURRENT == 2 and CURRENT == 1
  if (( CURRENT == 2)); then
    _describe -t commands "mix" _mix_arguments
  fi

  return 0
}

_mix

# NOTE: my_array=("${(@f)$(my_command)}")
# The above uses the lines of the output of my_command as the elements of my_array.
# f is the expansion flag to split on newlines (instead of on IFS)


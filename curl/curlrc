# Follow redirects
-L

# Automatically set the previous URL as referer when following a redirect
referer = ";auto"

# Abort if connection takes longer than 30 seconds (does not limit transfer time)
connect-timeout = 30

# Abort if the entire request takes longer than 5 minutes
max-time = 300

# Request compressed response and auto-decompress
compressed

# Simple progress bar instead of the verbose transfer stats table
progress-bar

# Schannel only (Windows curl.exe): skip the revocation check when the CRL/OCSP
# server is unreachable, as behind a TLS-inspecting proxy. A cert known to be
# revoked still fails. Needs curl 7.70.0 or later; other TLS backends ignore it.
ssl-revoke-best-effort

# Retry on transient errors (408, 429, 5xx)
retry = 3
retry-delay = 2
retry-max-time = 60

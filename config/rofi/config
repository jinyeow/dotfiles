rofi.matching:          fuzzy
rofi.tokenize:          true
rofi.m:                 -5
rofi.line-margin:       2
rofi.line-padding:      5
!rofi.filter:
rofi.separator-style:   solid
rofi.hide-scrollbar:    false
rofi.fullscreen:        false
rofi.fake-transparency: true
rofi.dpi:               -1
rofi.threads:           0
rofi.scrollbar-width:   10
rofi.scroll-method:     0
rofi.fake-background:   screenshot
rofi.click-to-exit:     true
rofi.show-match:        true
!rofi.theme:
rofi.color-enabled:     true
rofi.color-normal:      #88000000, darkblue, #88000000, darkblue, #f8f6f2
rofi.color-urgent:      #88000000, darkblue, #88000000, darkblue, #f8f6f2
rofi.color-active:      #88000000, darkblue, #88000000, darkblue, #f8f6f2
rofi.color-window:      #88000000
rofi.plugin-path:       /usr/lib/rofi
rofi.pid:               /run/user/1000/rofi.pid


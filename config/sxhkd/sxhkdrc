#
# bspwm hotkeys
#

super + alt + Escape
  ~/scripts/bspwm_logout
  # pkill -x panel; bspc quit

super + w
  bspc node -c

super + t
  bspc desktop -l next

super + b
  bspc node @focused:/ -B

super + {s,f}
  bspc node --state \~{floating,fullscreen}

super + {grave,Tab}
  bspc {node,desktop} -f last

super + apostrophe
  bspc node -s last

super + y
  bspc node -w last.manual

super + m
  bspc node -s biggest

super + {_,shift + }{h,j,k,l}
  bspc node -{f,s} {west,south,north,east}

super + {_,shift + }c
  bspc node --focus {next,prev}

super + {comma,period}
  bspc node --focus {prev,next}.local

super + bracket{left,right}
  bspc desktop --focus {prev,next}

super + ctrl + {h,j,k,l}
  bspc node -p {west,south,north,east}

super + ctrl + {_,shift + }space
  bspc {node -p cancel,desktop -c}

super + ctrl + {1-9}
  bspc node --presel-ratio 0.{1-9}

super + alt + {h,j,k,l}
  bspc node @{west,south,north,east} -r {-10,+10,-10,+10}

super + alt + shift + {h,j,k,l}
  bspc node @{east,north,south,west} -r {+10,-10,+10,-10}

super + {_,shift + }{1-9,0}
  bspc {desktop -f,node -d} ^{1-9,10}


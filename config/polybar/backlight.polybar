; NOTE: pretty sure i need to change a bunch of these settings
; NOTE: only use ONE of these two.

; TYPE 1
;type = internal/backlight
;card = intel_backlight
;;click-left = connman-gtk

;format = <label> <bar>
;label = ""

;bar-width = 10
;bar-indicator = |
;bar-indicator-foreground = #ff
;bar-indicator-font = 2
;bar-fill = ─
;bar-fill-font = 2
;bar-fill-foreground = ${colors.purple}
;bar-empty = ─
;bar-empty-font = 2
;bar-empty-foreground = ${colors.foreground-alt}

; TYPE 2
type = internal/backlight

card = intel_backlight
enable-scroll = true

format = <ramp><label>
format-underline = ${colors.purple}
label = %percentage%%

ramp-0 = 🌕
ramp-1 = 🌔
ramp-2 = 🌓
ramp-3 = 🌒
ramp-4 = 🌑

; vim:ft=dosini

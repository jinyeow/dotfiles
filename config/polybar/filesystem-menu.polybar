type = custom/text
content = "%{F#ffb52a}%{T5}%{T-}%{F-}"
click-left = polybar filesystem-bar

[bar/filesystem-bar]
; monitor = eDP1
width = 17%
height = 35
; radius = 6

background = ${colors.background-top}
foreground = ${colors.foreground-top}

border-size = 0
border-color =${colors.foreground}

border-bottom-size = 0
border-bottom-color = ${colors.foreground}

border-top-size = 0
border-top-color = ${colors.foreground}

border-right-size = 0
; border-right-color = ${colors.foreground}

offset-x = 1580
offset-y = 40

; padding = 3
module-margin = 1 
; separator = %{F#33}|

font-0 = Hack:size=11;1
font-1 = FontAwesome:size=11;1
; font-2 = MaterialIcons:size=11
;http://fontawesome.io/cheatsheet/
;https://shanfan.github.io/material-icons-cheatsheet/

modules-center = filesystem close-menu-bar

override-redirect = true

[module/close-menu-bar]
type = custom/text
; content = "%{F#259E83}%{F-}"
content = "%{F#259E83}[X]%{F-}"
click-left = "pkill -n polybar"

[module/filesystem]
type = internal/fs

; Mountpoints to display
mount-0 = /
mount-1 = /home

; Seconds to sleep between updates
; Default: 30
interval = 30

; Display fixed precision values
; Default: false
fixed-values = true

; Spacing between entries
; Default: 2
spacing = 1

; Available tags:
;   <label-mounted> (default)
;   <bar-free>
;   <bar-used>
;   <ramp-capacity>
format-mounted = <label-mounted>

; Available tags:
;   <label-unmounted> (default)
format-unmounted = <label-unmounted>

; Available tokens:
;   %mountpoint%
;   %type%
;   %fsname%
;   %percentage_free%
;   %percentage_used%
;   %total%
;   %free%
;   %used%
; Default: %mountpoint% %percentage_free%%
label-mounted = %mountpoint%: %free%

; Available tokens:
;   %mountpoint%
; Default: %mountpoint% is not mounted
label-unmounted = %mountpoint%: not mounted
label-unmounted-foreground = #55

; vim:ft=dosini

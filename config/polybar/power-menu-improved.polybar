type = custom/text
content = "%{F#ff5c56}%{F-}"
click-left = polybar powermenu-bar

[bar/powermenu-bar]
; monitor = eDP1
width = 21%
height = 35
; radius = 6

background = ${colors.background-top}
foreground = ${colors.foreground-top}

border-size = 0
border-color =${colors.foreground}

border-bottom-size = 0
border-bottom-color = ${colors.foreground}

border-top-size = 0
border-top-color = ${colors.foreground}

border-right-size = 0
; border-right-color = ${colors.foreground}

offset-x = 1500
offset-y = 40

; padding = 3
module-margin = 1 
separator = %{F#33}|

font-0 = Hack:size=11;1
font-1 = FontAwesome:size=11;1
; font-2 = MaterialIcons:size=11
;http://fontawesome.io/cheatsheet/
;https://shanfan.github.io/material-icons-cheatsheet/

modules-center = lock logout reboot poweroff closepowermenubar

override-redirect = true

[module/lock]
type = custom/text
content = "%{F#259E83} %{F-}Lock"
click-left = "pkill -n polybar ; sh ~/scripts/locker.sh"

; [module/suspend]
; type = custom/text
; content = "%{F#259E83}î %{F-}Suspend"
; click-left = "pkill -n polybar ; sh ~/.config/i3/Lock.sh && systemctl suspend"

[module/logout]
type = custom/text
content = "%{F#259E83}%{F-}Logout"
click-left = "pkill -n polybar ; sh ~/scripts/bspwm_logout

[module/reboot]
type = custom/text
content = "%{F#259E83}%{F-}Reboot"
click-left = "pkill -n polybar ; systemctl reboot"

[module/poweroff]
type = custom/text
content = "%{F#259E83}%{F-}Poweroff"
click-left = "pkill -n polybar ; systemctl poweroff"

[module/closepowermenubar]
type = custom/text
; content = "%{F#259E83}%{F-}"
content = "%{F#259E83}[X]%{F-}"
click-left = "pkill -n polybar"

[settings]
screenchange-reload = true
;compositing-background = xor
;compositing-background = screen
;compositing-foreground = source
;compositing-border = over

; vim:ft=dosini

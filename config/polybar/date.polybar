type = internal/date
interval = 5

; if `date-alt` or `time-alt` is defined, clicking
; the module will toggle between formats
date = " %d %b"
date-alt = ""

time =  %H:%M
time-alt = "%H:%M"

label =  %time%%date%

; NOTE: date.polybar used to be the custom/script below.
;       I changed it to the above since I think it's better.
;type = custom/script
;;exec = echo "  $(date +'%I:%M  %a %d %b')"
;exec = echo "$(date +'%d %b, %H:%M')"
;interval = 1
;;click-left = gnome-calendar

; vim:ft=dosini

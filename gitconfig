[alias]
    a = add
    aliases = config --get-regexp alias
    amend = commit --amend
    branches = branch -a
    c = commit
    cached = git diff --cached
    co = checkout
    conflicts = git diff --name-only --diff-filter=U
    ctags = !.git/hooks/ctags
    delete = rm -r --cached
    discard = checkout --
    f = fetch --all --prune
    fetchtags = fetch --tags -f
    filediff = diff --name-status
    fix = "!f() { ${EDITOR} `git diff --name-only`; }; f"
    graph = log --graph -50 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset• %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
    ignore = '!gi() { curl -L -s https://www.gitignore.io/api/$@ ;}; gi'
    last = log -1 HEAD --format=format:"%Cred%H"
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    listconflicts = git diff --name-only --diff-filter=U
    remotes = remote -v
    s = status --short
    st = status
    sp = status --porcelain
    staged = git diff --staged
    stashes = stash list
    tags = tag
    uncommit = reset --mixed HEAD~
    unstage = reset -q HEAD --
    unmerged = diff --name-only --diff-filter=U
    wta = worktree add
    wtl = worktree list
    wtr = worktree remove

[blame]
    date = relative

[branch]
    sort = -committerdate

[color]
    branch = auto
    diff = auto
    grep = auto
    interactive = auto
    status = auto
    ui = auto

[commit]
    template = ~/.gitmessage
    verbose = true

[core]
    attributesfile = ~/.gitattributes
    autocrlf = false
    editor = nvim
    excludesfile = ~/.gitignore
    fsmonitor = true
    hooksPath = ~/.git_templates/hooks
    ignoreCase = true
	longpaths = true
    pager = delta
    # Speed up commands involving untracked files such as `git status`.
    # https://git-scm.com/docs/git-update-index#_untracked_cache
    untrackedCache = true
    # Treat spaces before tabs and all kinds of trailing whitespace as an error
    # [default] trailing-space: looks for spaces at the end of a line
    # [default] space-before-tab: looks for spaces before tabs at the beginning of a line
    whitespace = blank-at-eol,space-before-tab,-indent-with-non-tab,tab-in-indent,trailing-space

# https://dandavison.github.io/delta/configuration.html
[delta]
    line-numbers = true
    navigate = true  # use n and N to move between diff sections
    side-by-side = true

[diff]
    # https://luppeng.wordpress.com/2020/10/10/when-to-use-each-of-the-git-diff-algorithms/
    algorithm = histogram
    # uses different colours to highlight lines in diffs that have been “moved”
    colorMoved = default
    # with diff.colorMoved set, also ignores indentation changes
    colorMovedWS = allow-indentation-change
    # include more context in diffs
    context = 10
	guitool = vscode
    submodule = log
    # tool = nvim
    tool = nvimdiff

[difftool "vscode"]
	path = C:/Program Files/Microsoft VS Code/Code.exe
	cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --diff \"$LOCAL\" \"$REMOTE\"

[fetch]
    # automatically delete remote tracking branches that have been deleted
	prune = true
    prunetags = true

[gpg]
    # allow you to sign commits with SSH keys
    format = ssh

[help]
    # Automatically correct and execute mistyped commands
    autocorrect = 1

[init]
    templatedir = ~/.git_templates
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[i18n]
	filesEncoding = utf-8

[log]
    date = iso
    decorate = full

[merge]
    # https://www.ductile.systems/zdiff3/
    conflictstyle = zdiff3
	guitool = vscode
    # Include summaries of merged commits in newly created merge commit messages
    log = true
    # tool = nvim
    tool = nvimdiff

[mergetool "vscode"]
	path = C:/Program Files/Microsoft VS Code/Code.exe
	cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

[pull]
    ff = only
	rebase = false

[push]
    autoSetupRemote = true
    default = simple
    # push new tags along with commits being pushed
    followtags = true

[rebase]
    autoStash = true
	autosquash = true
    # don’t allow deleting commits during a rebase
    missingCommitsCheck = error
    # makes it much easier to rebase multiple stacked branches at a time.
    # - https://andrewlock.net/working-with-stacked-branches-in-git-is-easier-with-update-refs/
	updateRefs = true
    stat = true

[rerere]
    enabled = true

[status]
    submoduleSummary = true

[submodule]
    recurse = true

[tag]
    sort = taggerdate
    # Versionsort
    # natural, numeric sorting (e.g., 1.0 before 1.10)
    # sort = version:refname
    # show the newest tags first (descending order), you can add a hyphen
    # sort = -version:refname

[url "git@github.com:"]
	insteadOf = "https://github.com/"
    insteadOf = "gh:"

[user]
	name = Justin Puah
	email = justin@puah.dev

[tig]
  diff-options = --show-signature

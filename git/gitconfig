[alias]
    a = add
    aliases = config --get-regexp alias
    amend = commit --amend
    branches = branch -a
    c = commit
    co = checkout
    conflicts = diff --name-only --diff-filter=U
    ctags = !sh -c 'exec "$HOME/.git_templates/hooks/ctags"'
    delete = rm -r --cached
    discard = checkout --
    f = fetch --all --prune
    fetchtags = fetch --tags -f
    filediff = diff --name-status
    fix = "!f() { \"${EDITOR:-nvim}\" $(git diff --name-only); }; f"
    graph = log --graph -50 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset• %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
    ignore = "!gi() { curl -L -s https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
    last = log -1 HEAD --format=format:"%Cred%H"
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    remotes = remote -v
    s = status --short
    st = status
    sp = status --porcelain
    staged = diff --staged
    stashes = stash list
    tags = tag
    uncommit = reset --mixed HEAD~
    unstage = reset -q HEAD --
    wta = worktree add
    wtl = worktree list
    wtr = worktree remove

[blame]
    date = relative

[branch]
    sort = -committerdate

[color]
    ui = auto

[column]
    ui = auto

[commit]
    template = ~/.gitmessage
    verbose = true

[core]
    attributesfile = ~/.gitattributes
    autocrlf = false
    editor = nvim
    excludesfile = ~/.gitignore
    fsmonitor = true
    hooksPath = ~/.git_templates/hooks
    longpaths = true
    pager = delta
    # https://git-scm.com/docs/git-update-index#_untracked_cache
    untrackedCache = true
    whitespace = blank-at-eol,space-before-tab,-indent-with-non-tab,tab-in-indent,trailing-space

# https://dandavison.github.io/delta/configuration.html
[delta]
    line-numbers = true
    navigate = true
    side-by-side = true
    syntax-highlighting = true

# Named feature blocks, activated via $env:DELTA_FEATURES (set alongside BAT_THEME in the
# PowerShell profile). Neither block sets an option already present in [delta] above, since
# delta ignores a feature's value for any option the base [delta] section already sets.
[delta "dark-mode"]
    syntax-theme = Catppuccin Mocha

[delta "light-mode"]
    light = true
    syntax-theme = Catppuccin Latte

[diff]
    # https://luppeng.wordpress.com/2020/10/10/when-to-use-each-of-the-git-diff-algorithms/
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change
    context = 10
    guitool = vscode
    submodule = log
    tool = nvimdiff

[difftool]
    prompt = false

[difftool "delta"]
    cmd = delta "$LOCAL" "$REMOTE"

[difftool "vscode"]
    path = C:/Program Files/Microsoft VS Code/Code.exe
    cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --diff \"$LOCAL\" \"$REMOTE\"

[fetch]
    # 0 = as many parallel submodule/remote fetches as fetch.jobs / CPU count allows
    parallel = 0
    # automatically delete remote tracking branches that have been deleted
    prune = true
    prunetags = true
    writeCommitGraph = true
    fsckObjects = true

[gpg]
    # allow you to sign commits with SSH keys
    format = ssh

[help]
    # prompt before running the corrected command, rather than auto-executing it
    autocorrect = prompt

[init]
    templatedir = ~/.git_templates
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[log]
    date = iso
    decorate = full

[maintenance]
    strategy = incremental

[merge]
    # parallels rebase.autoStash below
    autoStash = true
    # https://www.ductile.systems/zdiff3/
    conflictStyle = zdiff3
    guitool = vscode
    log = true
    tool = nvimdiff

[mergetool]
    prompt = false

[mergetool "vscode"]
    path = C:/Program Files/Microsoft VS Code/Code.exe
    cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

[pull]
    ff = only
    rebase = false

[push]
    autoSetupRemote = true
    default = simple
    followtags = true
    useForceIfIncludes = true

[rebase]
    autoStash = true
    autosquash = true
    # don't allow deleting commits during a rebase
    missingCommitsCheck = error
    rescheduleFailedExec = true
    # https://andrewlock.net/working-with-stacked-branches-in-git-is-easier-with-update-refs/
    updateRefs = true
    stat = true

[rerere]
    autoUpdate = true
    enabled = true

[tag]
    sort = version:refname

[transfer]
    fsckObjects = true

[tig]
    diff-options = --show-signature

[url "git@github.com:"]
    insteadOf = "https://github.com/"
    insteadOf = "gh:"

[user]
    name = Justin Puah
    email = justin@puah.dev


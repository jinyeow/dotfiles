[alias]
    a = add
    aliases = config --get-regexp alias
    amend = commit --amend
    branches = branch -a
    c = commit
    co = checkout
    conflicts = diff --name-only --diff-filter=U
    ctags = !.git/hooks/ctags
    delete = rm -r --cached
    discard = checkout --
    f = fetch --all --prune
    fetchtags = fetch --tags -f
    filediff = diff --name-status
    fix = "!f() { ${EDITOR} `git diff --name-only`; }; f"
    graph = log --graph -50 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset• %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
    ignore = '!gi() { curl -L -s https://www.gitignore.io/api/$@ ;}; gi'
    last = log -1 HEAD --format=format:"%Cred%H"
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    remotes = remote -v
    s = status --short
    st = status
    sp = status --porcelain
    staged = diff --staged
    stashes = stash list
    tags = tag
    uncommit = reset --mixed HEAD~
    unstage = reset -q HEAD --
    wta = worktree add
    wtl = worktree list
    wtr = worktree remove

[blame]
    date = relative

[branch]
    sort = -committerdate

[color]
    ui = auto

[commit]
    template = ~/.gitmessage
    verbose = true

[core]
    attributesfile = ~/.gitattributes
    autocrlf = false
    editor = nvim
    excludesfile = ~/.gitignore
    fsmonitor = true
    hooksPath = ~/.git_templates/hooks
    ignoreCase = true
    longpaths = true
    pager = delta
    # https://git-scm.com/docs/git-update-index#_untracked_cache
    untrackedCache = true
    whitespace = blank-at-eol,space-before-tab,-indent-with-non-tab,tab-in-indent,trailing-space

# https://dandavison.github.io/delta/configuration.html
[delta]
    line-numbers = true
    navigate = true
    side-by-side = true
    syntax-highlighting = true

[diff]
    # https://luppeng.wordpress.com/2020/10/10/when-to-use-each-of-the-git-diff-algorithms/
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change
    context = 10
    guitool = vscode
    submodule = log
    tool = nvimdiff

[difftool]
    prompt = false

[difftool "delta"]
    cmd = delta "$LOCAL" "$REMOTE"

[difftool "vscode"]
    path = C:/Program Files/Microsoft VS Code/Code.exe
    cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --diff \"$LOCAL\" \"$REMOTE\"

[fetch]
    # automatically delete remote tracking branches that have been deleted
    prune = true
    prunetags = true
    writeCommitGraph = true

[gpg]
    # allow you to sign commits with SSH keys
    format = ssh

[help]
    # automatically correct and execute mistyped commands after 0.1s
    autocorrect = 1

[init]
    templatedir = ~/.git_templates
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[i18n]
    filesEncoding = utf-8

[log]
    date = iso
    decorate = full

[merge]
    # https://www.ductile.systems/zdiff3/
    conflictStyle = zdiff3
    guitool = vscode
    log = true
    tool = nvimdiff

[mergetool]
    prompt = false

[mergetool "vscode"]
    path = C:/Program Files/Microsoft VS Code/Code.exe
    cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

[pull]
    ff = only
    rebase = false

[push]
    autoSetupRemote = true
    default = simple
    followtags = true

[rebase]
    autoStash = true
    autosquash = true
    # don't allow deleting commits during a rebase
    missingCommitsCheck = error
    # https://andrewlock.net/working-with-stacked-branches-in-git-is-easier-with-update-refs/
    updateRefs = true
    stat = true

[rerere]
    enabled = true

[status]
    submoduleSummary = true

[submodule]
    recurse = true

[tag]
    sort = taggerdate

[tig]
    diff-options = --show-signature

[url "git@github.com:"]
    insteadOf = "https://github.com/"
    insteadOf = "gh:"

[user]
    name = Justin Puah
    email = justin@puah.dev

# Work identity — overrides [user] and tool prefs for repos with a work remote URL.
# Requires Git 2.36+. For local-only work repos without a remote yet, run:
#   git config user.email justin.puah@hollard.com.au
[includeIf "hasconfig:remote.*.url:*hollard*"]
    path = ~/.gitconfig-work

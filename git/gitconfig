[alias]
    a = add
    aliases = config --get-regexp alias
    amend = commit --amend
    branches = branch -a
    c = commit
    co = checkout
    conflicts = diff --name-only --diff-filter=U
    ctags = !sh -c 'exec "$HOME/.git_templates/hooks/ctags"'
    delete = rm -r --cached
    discard = checkout --
    f = fetch --all --prune
    fetchtags = fetch --tags -f
    filediff = diff --name-status
    fix = "!f() { \"${EDITOR:-nvim}\" $(git diff --name-only); }; f"
    graph = log --graph -50 --branches --remotes --tags  --format=format:'%Cgreen%h %Creset• %<(75,trunc)%s (%cN, %cr) %Cred%d' --date-order
    ignore = "!gi() { curl -L -s https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
    last = log -1 HEAD --format=format:"%Cred%H"
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
    remotes = remote -v
    s = status --short
    st = status
    sp = status --porcelain
    staged = diff --staged
    stashes = stash list
    tags = tag
    uncommit = reset --mixed HEAD~
    unstage = reset -q HEAD --
    wta = worktree add
    wtl = worktree list
    wtr = worktree remove

[blame]
    date = relative

[branch]
    sort = -committerdate

[color]
    ui = auto

[column]
    ui = auto

[commit]
    template = ~/.gitmessage
    verbose = true

[core]
    # Installed from git/gitattributes: per-type whitespace rules (tabs in Go and Makefiles).
    attributesfile = ~/.gitattributes
    autocrlf = false
    editor = nvim
    excludesfile = ~/.gitignore
    fsmonitor = true
    longpaths = true
    pager = delta
    # https://git-scm.com/docs/git-update-index#_untracked_cache
    untrackedCache = true
    whitespace = blank-at-eol,space-before-tab,-indent-with-non-tab,tab-in-indent,trailing-space

# https://dandavison.github.io/delta/configuration.html
[delta]
    line-numbers = true
    navigate = true
    side-by-side = true
    syntax-highlighting = true

# Named feature blocks, activated via $env:DELTA_FEATURES (set alongside BAT_THEME in the
# PowerShell profile). Neither block sets an option already present in [delta] above, since
# delta ignores a feature's value for any option the base [delta] section already sets.
[delta "dark-mode"]
    syntax-theme = Catppuccin Mocha

[delta "light-mode"]
    light = true
    syntax-theme = Catppuccin Latte

[diff]
    # https://luppeng.wordpress.com/2020/10/10/when-to-use-each-of-the-git-diff-algorithms/
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change
    context = 10
    guitool = vscode
    submodule = log
    tool = nvimdiff

[difftool]
    prompt = false

[difftool "delta"]
    cmd = delta "$LOCAL" "$REMOTE"

[difftool "vscode"]
    path = C:/Program Files/Microsoft VS Code/Code.exe
    cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --diff \"$LOCAL\" \"$REMOTE\"

[fetch]
    # 0 = as many parallel submodule/remote fetches as fetch.jobs / CPU count allows
    parallel = 0
    # automatically delete remote tracking branches that have been deleted
    prune = true
    prunetags = true
    writeCommitGraph = true
    fsckObjects = true

[gpg]
    # allow you to sign commits with SSH keys
    format = ssh

[help]
    # prompt before running the corrected command, rather than auto-executing it
    autocorrect = prompt

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[log]
    date = iso
    decorate = full

[maintenance]
    strategy = incremental

[merge]
    # parallels rebase.autoStash below
    autoStash = true
    # https://www.ductile.systems/zdiff3/
    conflictStyle = zdiff3
    guitool = vscode
    log = true
    tool = nvimdiff

[mergetool]
    prompt = false

[mergetool "vscode"]
    path = C:/Program Files/Microsoft VS Code/Code.exe
    cmd = \"C:/Program Files/Microsoft VS Code/Code.exe\" --new-window --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

[pull]
    ff = only
    rebase = false

[push]
    autoSetupRemote = true
    default = simple
    followtags = true
    useForceIfIncludes = true

[rebase]
    autoStash = true
    autosquash = true
    # don't allow deleting commits during a rebase
    missingCommitsCheck = error
    rescheduleFailedExec = true
    # https://andrewlock.net/working-with-stacked-branches-in-git-is-easier-with-update-refs/
    updateRefs = true
    stat = true

[rerere]
    autoUpdate = true
    enabled = true

[tag]
    sort = version:refname

[transfer]
    fsckObjects = true

[tig]
    diff-options = --show-signature

# Fetch GitHub over HTTPS (works on keyless machines and where port 22 is blocked), push
# over SSH. The gh: shorthand takes the same split: git applies insteadOf and
# pushInsteadOf to the original URL, not to each other's output.
[url "https://github.com/"]
    insteadOf = "gh:"

[url "git@github.com:"]
    pushInsteadOf = "https://github.com/"
    pushInsteadOf = "gh:"

[user]
    name = Justin Puah
    email = justin@puah.dev

# Global hooks, as config-based hooks (Git >= 2.54) instead of core.hooksPath. A global
# hooksPath masks every repo's own .git/hooks and stops the pre-commit framework from
# installing. Configured hooks run first, then the repo's own hook for the same event.
#
# Git runs each command as `sh -c '<command> "$@"'` with the hook's usual arguments, so
# `exec "$f"` gets them (and stdin, for post-rewrite) unchanged. Every command:
#   - is double-quoted: `;` starts a comment in git config, so unquoted the value would
#     end at the guard and the script would never run;
#   - quotes "$HOME/..." so a profile path with spaces survives sh word-splitting;
#   - fails open with `test -f ... || exit 0` while ~/.git_templates is not installed
#     yet (git blocks the commit on a missing command), but uses -f and not -x so a
#     present but broken script still fails loudly.
# Pinned by tests/git-config.Tests.ps1. Inspect: git hook list pre-commit
[hook "dotfiles-pre-commit"]
    event = pre-commit
    command = "f=\"$HOME/.git_templates/hooks/pre-commit\"; test -f \"$f\" || exit 0; exec \"$f\""

[hook "dotfiles-prepare-commit-msg"]
    event = prepare-commit-msg
    command = "f=\"$HOME/.git_templates/hooks/prepare-commit-msg\"; test -f \"$f\" || exit 0; exec \"$f\""

[hook "dotfiles-commit-msg"]
    event = commit-msg
    command = "f=\"$HOME/.git_templates/hooks/commit-msg\"; test -f \"$f\" || exit 0; exec \"$f\""

[hook "dotfiles-post-commit"]
    event = post-commit
    command = "f=\"$HOME/.git_templates/hooks/post-commit\"; test -f \"$f\" || exit 0; exec \"$f\""

[hook "dotfiles-post-checkout"]
    event = post-checkout
    command = "f=\"$HOME/.git_templates/hooks/post-checkout\"; test -f \"$f\" || exit 0; exec \"$f\""

[hook "dotfiles-post-merge"]
    event = post-merge
    command = "f=\"$HOME/.git_templates/hooks/post-merge\"; test -f \"$f\" || exit 0; exec \"$f\""

[hook "dotfiles-post-rewrite"]
    event = post-rewrite
    command = "f=\"$HOME/.git_templates/hooks/post-rewrite\"; test -f \"$f\" || exit 0; exec \"$f\""

# Machine-local settings, loaded last so they win. ~/.gitconfig.local is untracked: it holds
# the [work] keys and the [includeIf] blocks that load ~/.gitconfig-work. See git/README.md.
[include]
    path = ~/.gitconfig.local

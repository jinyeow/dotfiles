#!/bin/sh
# Work-only pre-push warnings. Wired via [hook "work-push-warnings"] in git/gitconfig-work,
# so it runs ONLY in repos that load that file (the [includeIf] blocks in
# ~/.gitconfig.local).
#
# Warns when a pushed branch's upstream is gone, or when it is more than 20 commits
# behind origin's default branch. The default branch is the one origin/HEAD points at,
# else origin/main, else origin/master, whichever ref exists first. Uses local
# remote-tracking refs only (no fetch). It never blocks: every path exits 0.
#
# Git passes one line per pushed ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# Deletes (all-zero local sha) and pushes to anything other than a remote branch (tags)
# are skipped. The decision uses the remote ref, because the local ref is whatever was
# typed (`git push origin HEAD` gives `HEAD`).

MAX_BEHIND=20

warn() {
    echo "work-push-warnings: $1" >&2
}

# origin/HEAD is unset in a repo whose origin was added by hand, so fall back to the
# usual names. An unset origin/HEAD gives an empty first entry, which is skipped.
default=""
for ref in "$(git symbolic-ref -q refs/remotes/origin/HEAD)" refs/remotes/origin/main refs/remotes/origin/master; do
    [ -n "$ref" ] || continue
    if git show-ref -q --verify "$ref"; then
        default="$ref"
        break
    fi
done

# The fourth field (the remote sha) is read into _ so that it does not join remote_ref.
while read -r local_ref local_sha remote_ref _; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

    # The local branch, for the upstream check: the ref itself, or what HEAD points at.
    # When it cannot be resolved (a bare sha, a detached HEAD), only that check is skipped.
    case "$local_ref" in
        refs/heads/*) branch_ref="$local_ref" ;;
        HEAD|@) branch_ref="$(git symbolic-ref -q HEAD)" ;;
        *) branch_ref="" ;;
    esac
    if [ -n "$branch_ref" ]; then
        branch="${branch_ref#refs/heads/}"
        if [ "$(git for-each-ref --format='%(upstream:track)' "$branch_ref" 2>/dev/null)" = "[gone]" ]; then
            warn "the upstream of $branch is gone (per local remote-tracking refs; run git fetch --prune to refresh)."
        fi
    else
        branch="${remote_ref#refs/heads/}"
    fi

    [ -n "$default" ] || continue
    behind="$(git rev-list --count "$local_sha..$default" 2>/dev/null)" || continue
    if [ "${behind:-0}" -gt "$MAX_BEHIND" ]; then
        warn "$branch is $behind commits behind ${default#refs/remotes/} (per local remote-tracking refs; run git fetch to refresh)."
    fi
done

exit 0

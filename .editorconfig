# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[.{,ba}sh*]
indent_size = 4

[.git*]
indent_size = 4

[*.json{,c}]
indent_size = 2

[*.ps{,d,m}1]
indent_size = 4
